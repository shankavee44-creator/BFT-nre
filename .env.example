# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CRYPTOMUS_MERCHANT_ID: Merchant UUID from Cryptomus Dashboard for automated USDT (TRC-20) deposits.
CRYPTOMUS_MERCHANT_ID="MY_CRYPTOMUS_MERCHANT_ID"

# CRYPTOMUS_API_KEY: Payment API Key from Cryptomus Dashboard used to sign invoice requests and verify webhooks.
CRYPTOMUS_API_KEY="MY_CRYPTOMUS_API_KEY"
